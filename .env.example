# Sem estas variáveis o app roda com os dados fictícios de src/data/fixtures.ts.
# Com elas, o repositório passa a ler o Supabase criado por supabase/migrations.

NEXT_PUBLIC_SUPABASE_URL=https://gxzvlknlxwihooqgctst.supabase.co

# Service role: o ERP é interno e todas as consultas rodam no servidor.
# As policies só liberam leitura para `authenticated`, então a chave anon/
# publishable devolveria listas vazias — não use aqui.
# Copie em: Supabase → Project Settings → API → service_role.
# NUNCA prefixe com NEXT_PUBLIC_ (isso a exporia no bundle do navegador).
SUPABASE_SERVICE_ROLE_KEY=
